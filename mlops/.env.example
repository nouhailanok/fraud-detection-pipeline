# ============================================================================
# .env — Local node + Flower server monitoring
# ============================================================================

# Local node identity (must be unique for each bank machine)
COMPOSE_PROJECT_NAME=bank-node-1
CLIENT_ID=1
NODE_NAME=bank-node-1

# Flower server AWS endpoint (used by local client.py process)
# FLOWER_SERVER_HOST=ec2-xx-xx-xx-xx.eu-west-3.compute.amazonaws.com
FLOWER_SERVER_PORT=8080
FLOWER_SERVER_ADDRESS=http://localhost:8080

# FL hyperparameters (used by local ingestion/client processes)
FL_LR=0.0005
FL_BATCH_SIZE=256
FL_SEQ_LEN=5
FL_TRAIN_RATIO=0.8
FL_MAX_LOCAL_ROWS=4000
FL_ROUNDS=50
FL_MIN_CLIENTS=2

# Differential privacy settings (used by local client process)
DP_EPSILON=1.0
DP_DELTA=1e-5
DP_MAX_GRAD_NORM=1.0

# Local Docker infra
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Local client monitoring stack (docker-compose.local.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMeNow123!
GRAFANA_ROOT_URL=http://localhost:3000

# Server monitoring stack (docker-compose.server.yml)
SERVER_PROMETHEUS_PORT=9190
SERVER_GRAFANA_PORT=3300
SERVER_GRAFANA_ADMIN_USER=admin
SERVER_GRAFANA_ADMIN_PASSWORD=pwd123
SERVER_GRAFANA_ROOT_URL=http://localhost:3300
SERVER_PUSHGATEWAY_PORT=9191
SERVER_NODE_EXPORTER_PORT=19100
SERVER_CADVISOR_PORT=18080

# Flower state exporter
FL_EXPORTER_PORT=9108
FL_EXPORTER_POLL_SECONDS=15

# Bento model serving (local process)
BENTOML_MODEL_NAME=fraud_dpgru_v1
FRAUD_THRESHOLD=0.5
